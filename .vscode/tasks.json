{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run FasalSathi Web App",
            "type": "shell",
            "windows": {
                "command": "\"${workspaceFolder}\\run-app.bat\""
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            }
        },
        {
            "label": "Build FasalSathi",
            "type": "shell",
            "command": "mvn clean package",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$java",
            "group": "build"
        }
    ]
}
